# Lodestar configuration. Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------- required
ENVIRONMENT=development                 # development | test | staging | production
DEMO_MODE=true                          # labelled fixtures & fixture connectors; MUST be false in production
SECRET_KEY=change-me-to-64-random-chars # required in production
# Fernet key for the local encrypted secret store (required in production):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
SECRETS_BACKEND=local                   # local | aws (Secrets Manager)

# Owner role runs migrations; the runtime role (no superuser, RLS enforced) serves requests.
DATABASE_URL=postgresql+psycopg://localhost:5432/aseo
DATABASE_APP_URL=postgresql+psycopg://aseo_app:aseo_app_dev_password@localhost:5432/aseo
REDIS_URL=redis://localhost:6379/0
TASK_EXECUTION=inline                   # inline (single process) | celery (workers + beat)

PUBLIC_WEB_URL=http://localhost:3400
PUBLIC_API_URL=http://localhost:8400
CORS_ORIGINS=["http://localhost:3400"]
COOKIE_SECURE=false                     # true in production (HTTPS)

# ---------------------------------------------------------------- crawler
CRAWLER_MAX_PAGES=200
CRAWLER_DEFAULT_DELAY_SECONDS=0.25
# Dev/test only: host:port pairs allowed despite resolving to private IPs (e.g. the WP fixture).
CRAWLER_ALLOWED_PRIVATE_HOSTS=["127.0.0.1:8481"]

# ---------------------------------------------------------------- AI (optional)
AI_PROVIDER=deterministic               # anthropic | deterministic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- integrations (optional)
GOOGLE_CLIENT_ID=                       # Search Console OAuth (docs/setup/search-console.md)
GOOGLE_CLIENT_SECRET=
SHOPIFY_API_KEY=                        # docs/setup/shopify.md
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-07
GITHUB_APP_ID=                          # docs/setup/github.md
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=                 # PEM; \n-escaped is fine
GITHUB_WEBHOOK_SECRET=
BILLING_PROVIDER=test                   # test | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STORAGE_BACKEND=local                   # local | s3 (S3_BUCKET, S3_ENDPOINT_URL)
SNAPSHOT_DIR=var/snapshots
